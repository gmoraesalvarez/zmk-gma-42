#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>


#define COMBO(NAME, BINDINGS, KEYPOS, LAYER) \
  combo_##NAME { \
    timeout-ms = <50>; \
    bindings = <BINDINGS>; \
    key-positions = <KEYPOS>; \
    layers = <LAYER>; \
  };

/ {


        behaviors {
                hm: homerow_mods {
                        compatible = "zmk,behavior-hold-tap";
                        label = "HOMEROW_MODS";
                        #binding-cells = <2>;
                        tapping_term_ms = <190>;
                        quick-tap-ms = <175>;
                        flavor = "tap-preferred";
                        bindings = <&kp>, <&kp>;
                };
        };

        combos {
                compatible = "zmk,combos";
                COMBO(bt0, &to 1, 8 12, 0)
                COMBO(bt2, &to 1, 8 12, 2)
                COMBO(bt3, &to 1, 8 12, 3)
                COMBO(bt4, &to 1, 8 12, 4)
                COMBO(bt5, &to 1, 8 12, 5)
                COMBO(bt6, &to 1, 8 12, 6)
                COMBO(bt7, &to 1, 8 12, 7)
                COMBO(bt8, &to 1, 8 12, 8)
                COMBO(bt9, &to 1, 8 12, 9)
                COMBO(bt10, &to 1, 8 12, 10)
                COMBO(to2, &to 2, 0 3, 0)
                COMBO(to3, &to 3, 0 3, 2)
                COMBO(to4, &to 4, 0 3, 3)
                COMBO(to5, &to 5, 0 3, 4)
                COMBO(to6, &to 6, 0 3, 5)
                COMBO(to7, &to 7, 0 3, 6)
                COMBO(to8, &to 8, 0 3, 7)
                COMBO(to9, &to 9, 0 3, 8)
                COMBO(to10, &to 10, 0 3, 9)
                COMBO(to0, &to 0, 0 3, 10)
     
        };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";
            
            bindings =<
                &kp L      &kp U    &kp I
                &kp O      &kp J    &kp DOT    &kp E    &kp COMMA 
                &kp N      &kp H              &kp K    &kp M    &kp Y
            >;

        };

        bt_layer {
            display-name = "bt";

            bindings =<
                &bt BT_SEL 0     &bt BT_SEL 1   &bt BT_SEL 2
                &kp N0      &kp N0    &kp N0    &kp N0    &kp N0
                &tog 1      &kp N0              &kp N0    &kp N0    &bt BT_CLR
            >;

        };

        function_layer {
            display-name = "Function";

            bindings =<
                &kp F1      &kp F2    &kp F3
                &kp F4      &kp F5    &kp F6    &kp F7    &kp F8
                &kp F9      &kp F10              &kp F11    &kp F12    &kp F14
            >;

        };

        extra_layer1 {
            display-name = "Extra1";

            bindings =<
                &kp N1      &kp N2    &kp N3
                &kp N4      &kp N5    &kp N6    &kp N7    &kp N8
                &kp N9      &kp N0              &kp SEMI    &kp MINUS    &kp EQUAL
            >;

        };
        extra_layer2 {
            display-name = "Extra2";

            bindings =<
                &kp Q      &kp W    &kp F
                &kp P      &kp G    &kp A    &kp R    &kp S
                &kp T      &kp D              &kp Z    &kp X    &kp C
            >;

        };
        extra_layer3 {
            display-name = "Extra3";

            bindings =<
                &kp L      &kp U    &kp I
                &kp O      &kp J    &kp DOT    &kp E    &kp COMMA 
                &kp N      &kp H              &kp K    &kp M    &kp Y
            >;

        };
        extra_layer4 {
            display-name = "Extra4";

            bindings =<
                &kp N1      &kp N2    &kp N3
                &kp N4      &kp N5    &kp N6    &kp N7    &kp N8
                &kp N9      &kp N0              &kp SEMI    &kp MINUS    &kp EQUAL
            >;

        };
        extra_layer5 {
            display-name = "Extra5";

            bindings =<
                &kp Q      &kp W    &kp F
                &kp P      &kp G    &kp A    &kp R    &kp S
                &kp T      &kp D              &kp Z    &kp X    &kp C
            >;

        };
        extra_layer6 {
            display-name = "Extra6";

            bindings =<
                &kp L      &kp U    &kp I
                &kp O      &kp J    &kp DOT    &kp E    &kp COMMA 
                &kp N      &kp H              &kp K    &kp M    &kp Y
            >;

        };
        extra_layer7 {
            display-name = "Extra7";

            bindings =<
                &kp N1      &kp N2    &kp N3
                &kp N4      &kp N5    &kp N6    &kp N7    &kp N8
                &kp N9      &kp N0              &kp SEMI    &kp MINUS    &kp EQUAL
            >;

        };
        extra_layer8 {
            display-name = "Extra8";

            bindings =<
                &kp Q      &kp W    &kp F
                &kp P      &kp G    &kp A    &kp R    &kp S
                &kp T      &kp D              &kp Z    &kp X    &kp C
            >;

        };
    };
};
