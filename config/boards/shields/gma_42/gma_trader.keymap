#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>


#define COMBO(NAME, BINDINGS, KEYPOS, LAYER) \
  combo_##NAME { \
    timeout-ms = <50>; \
    bindings = <BINDINGS>; \
    key-positions = <KEYPOS>; \
    layers = <LAYER>; \
  };

/ {


        behaviors {
                hm: homerow_mods {
                        compatible = "zmk,behavior-hold-tap";
                        label = "HOMEROW_MODS";
                        #binding-cells = <2>;
                        tapping_term_ms = <190>;
                        quick-tap-ms = <175>;
                        flavor = "tap-preferred";
                        bindings = <&kp>, <&kp>;
                };
        };

        combos {
                compatible = "zmk,combos";
                COMBO(bt0, &to 1, 8 12, 0)
                COMBO(bt2, &to 1, 8 12, 2)
                COMBO(bt3, &to 1, 8 12, 3)
                COMBO(bt4, &to 1, 8 12, 4)
                COMBO(bt5, &to 1, 8 12, 5)
                COMBO(bt6, &to 1, 8 12, 6)
                COMBO(bt7, &to 1, 8 12, 7)
                COMBO(bt8, &to 1, 8 12, 8)
                COMBO(bt9, &to 1, 8 12, 9)
                COMBO(bt10, &to 1, 8 12, 10)
                COMBO(to2, &to 2, 0 3, 0)
                COMBO(to3, &to 3, 0 3, 2)
                COMBO(to4, &to 4, 0 3, 3)
                COMBO(to5, &to 5, 0 3, 4)
                COMBO(to6, &to 6, 0 3, 5)
                COMBO(to7, &to 7, 0 3, 6)
                COMBO(to8, &to 8, 0 3, 7)
                COMBO(to9, &to 9, 0 3, 8)
                COMBO(to10, &to 10, 0 3, 9)
                COMBO(to0, &to 0, 0 3, 10)
     
        };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";
            
            bindings =<
                &kp LC(LS(LA(L)))      &kp LC(LS(LA(U)))    &kp LC(LS(LA(I)))
                &kp LC(LS(LA(O)))      &kp LC(LS(LA(J)))    &kp LC(LS(LA(DOT)))    &kp LC(LS(LA(E)))    &kp LC(LS(LA(COMMA)))
                &kp LC(LS(LA(N)))      &kp LC(LS(LA(H)))              &kp LC(LS(LA(K)))    &kp LC(LS(LA(M)))    &kp LC(LS(LA(Y)))
            >;

        };

        bt_layer {
            display-name = "bt";

            bindings =<
                &bt BT_SEL 0     &bt BT_SEL 1   &bt BT_SEL 2
                &kp N0      &kp N0    &kp N0    &kp N0    &kp N0
                &tog 1      &kp N0              &kp N0    &kp N0    &bt BT_CLR
            >;

        };

        function_layer {
            display-name = "Function";

            bindings =<
                &kp F1      &kp F2    &kp F3
                &kp F4      &kp F5    &kp F6    &kp F7    &kp F8
                &kp F9      &kp F10              &kp F11    &kp F12    &kp F14
            >;

        };

        extra_layer1 {
            display-name = "Extra1";

            bindings =<
                &kp LC(LS(LA(N1)))      &kp LC(LS(LA(N2)))    &kp LC(LS(LA(N3)))
                &kp LC(LS(LA(N4)))      &kp LC(LS(LA(N5)))    &kp LC(LS(LA(N6)))    &kp LC(LS(LA(N7)))    &kp LC(LS(LA(N8)))
                &kp LC(LS(LA(N9)))      &kp LC(LS(LA(N0)))              &kp LC(LS(LA(SEMI)))    &kp LC(LS(LA(MINUS)))    &kp LC(LS(LA(EQUAL)))
            >;

        };
        extra_layer2 {
            display-name = "Extra2";

            bindings =<
                &kp LC(LS(LA(Q)))      &kp LC(LS(LA(W)))    &kp LC(LS(LA(F)))
                &kp LC(LS(LA(P)))      &kp LC(LS(LA(G)))    &kp LC(LS(LA(A)))    &kp LC(LS(LA(R)))    &kp LC(LS(LA(S)))
                &kp LC(LS(LA(T)))      &kp LC(LS(LA(D)))              &kp LC(LS(LA(Z)))    &kp LC(LS(LA(X)))    &kp LC(LS(LA(C)))
            >;

        };
        extra_layer3 {
            display-name = "Extra3";

            bindings =<
                &kp LC(LS(L))      &kp LC(LS(U))    &kp LC(LS(I))
                &kp LC(LS(O))      &kp LC(LS(J))    &kp LC(LS(DOT))    &kp LC(LS(E))    &kp LC(LS(COMMA)) 
                &kp LC(LS(N))      &kp LC(LS(H))              &kp LC(LS(K))    &kp LC(LS(M))    &kp LC(LS(Y))
            >;

        };
        extra_layer4 {
            display-name = "Extra4";

            bindings =<
                &kp LC(LS(N1))      &kp LC(LS(N2))    &kp LC(LS(N3))
                &kp LC(LS(N4))      &kp LC(LS(N5))    &kp LC(LS(N6))    &kp LC(LS(N7))    &kp LC(LS(N8))
                &kp LC(LS(N9))      &kp LC(LS(N0))              &kp LC(LS(SEMI))    &kp LC(LS(MINUS))    &kp LC(LS(EQUAL))
            >;

        };
        extra_layer5 {
            display-name = "Extra5";

            bindings =<
                &kp LC(LS(Q))      &kp LC(LS(W))    &kp LC(LS(F))
                &kp LC(LS(P))      &kp LC(LS(G))    &kp LC(LS(A))    &kp LC(LS(R))   &kp LC(LS(S))
                &kp LC(LS(T))      &kp LC(LS(D))              &kp LC(LS(Z))    &kp LC(LS(X))    &kp LC(LS(C))
            >;

        };
        extra_layer6 {
            display-name = "Extra6";

            bindings =<
                &kp LC(LA(L))      &kp LC(LA(U))    &kp LC(LA(I))
                &kp LC(LA(O))      &kp LC(LA(J))    &kp LC(LA(DOT))    &kp LC(LA(E))    &kp LC(LA(COMMA)) 
                &kp LC(LA(N))      &kp LC(LA(H))             &kp LC(LA(K))    &kp LC(LA(M))    &kp LC(LA(Y))
            >;

        };
        extra_layer7 {
            display-name = "Extra7";

            bindings =<
                &kp LC(LA(N1))      &kp LC(LA(N2))    &kp LC(LA(N3))
                &kp LC(LA(N4))      &kp LC(LA(N5))    &kp LC(LA(N6))    &kp LC(LA(N7))    &kp LC(LA(N8))
                &kp LC(LA(N9))      &kp LC(LA(N0))              &kp LC(LA(SEMI))    &kp LC(LA(MINUS))    &kp LC(LA(EQUAL))
            >;

        };
        extra_layer8 {
            display-name = "Extra8";

            bindings =<
                &kp LC(LA(Q))      &kp LC(LA(W))    &kp LC(LA(F))
                &kp LC(LA(P))      &kp LC(LA(G))    &kp LC(LA(A))    &kp LC(LA(R))    &kp LC(LA(S))
                &kp LC(LA(T))      &kp LC(LA(D))              &kp LC(LA(Z))    &kp LC(LA(X))    &kp LC(LA(C))
            >;

        };
    };
};
