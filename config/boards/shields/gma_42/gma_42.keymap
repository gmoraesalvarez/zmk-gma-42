#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <135>;
            bindings = <&kp M>, <&mo 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";

            bindings = <
                &kp ESC      &kp Q    &kp W    &kp E       &kp R &kp T &kp Y &kp U    &kp I     &kp O    &kp P     &kp BSPC
                &ht CAPS TAB &kp A    &kp S    &kp D       &kp F &kp G &kp H &kp J    &kp K     &kp L    &kp APOS  &kp RSHFT
                &kp LSHFT    &kp Z    &kp X    &kp C       &kp V &kp B &kp N &kp M    &kp COMMA &kp DOT  &kp FSLH  &kp RET
                                        &kp LCTRL  &kp LALT  SPACE    &kp BSPC &kp RALT  &mo 1
            >;
        };

        function_layer {
            display-name = "Function";

            bindings =<
                &kp GRAVE &kp N1   &kp N2    &kp N3 &kp N4 &kp N5 &kp N6   &kp N7   &kp N8    &kp N9    &kp N0   &kp DEL
                &none     &kp HOME &kp PG_UP &trans &trans &trans &kp LBKT &kp RBKT &kp EQUAL &kp BSLH  &kp FSLH &trans
                &trans    &kp END  &kp PG_DN &trans &trans &trans &trans   &trans   &trans    &kp UP    &trans   &trans
                                         &trans &trans  &trans    &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };
    };
};
