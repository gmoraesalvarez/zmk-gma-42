#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>


#define COMBO(NAME, BINDINGS, KEYPOS, LAYER) \
  combo_##NAME { \
    timeout-ms = <50>; \
    bindings = <BINDINGS>; \
    key-positions = <KEYPOS>; \
    layers = <LAYER>; \
  };

/ {


        behaviors {
                hm: homerow_mods {
                        compatible = "zmk,behavior-hold-tap";
                        label = "HOMEROW_MODS";
                        #binding-cells = <2>;
                        tapping_term_ms = <190>;
                        quick-tap-ms = <175>;
                        flavor = "tap-preferred";
                        bindings = <&kp>, <&kp>;
                };
        };

        combos {
                compatible = "zmk,combos";
                      
                COMBO(bt0, &to 1, 10 14, 0)
                COMBO(bt2, &to 1, 10 14, 2)
                COMBO(bt3, &to 1, 10 14, 3)
                COMBO(bt4, &to 1, 10 14, 4)
                COMBO(bt5, &to 1, 10 14, 5)
                COMBO(bt6, &to 1, 10 14, 6)
                COMBO(bt7, &to 1, 10 14, 7)
     
        };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";
            
            bindings =<
                &kp N7      &kp N8    &kp N9    &kp STAR      &kp EQL
                &kp N4      &kp N5    &kp N6    &kp KP_SLASH  &tog 1
                &kp N1      &kp N2    &kp N3    &kp KP_DOT    &kp N0   
            >;
            sensor-bindings = <&inc_dec_kp J L>;

        };

        bt_layer {
            display-name = "bt";

            bindings =<
                &trans      &trans    &trans    &trans    &trans
                &trans      &trans    &trans    &trans    &trans
                &trans      &trans    &trans    &trans    &trans
                  
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;

        };

        function_layer {
            display-name = "Function";

            bindings =<
                &trans      &trans    &trans    &trans    &trans
                &trans      &trans    &trans    &trans    &trans
                &trans      &trans    &trans    &trans    &trans
            >;
            sensor-bindings = <&inc_dec_kp LEFT RIGHT>;

        };

        extra_layer1 {
            display-name = "Extra1";

            bindings =<
                &trans      &trans    &trans    &trans    &trans
                &trans      &trans    &trans    &trans    &trans
                &trans      &trans    &trans    &trans    &trans
            >;
            sensor-bindings = <&inc_dec_kp COMMA DOT>;

        };
        extra_layer2 {
            display-name = "Extra2";

            bindings =<
                &trans      &trans    &trans    &trans    &trans
                &trans      &trans    &trans    &trans    &trans
                &trans      &trans    &trans    &trans    &trans
            >;
            sensor-bindings = <&inc_dec_kp DOWN UP>;

        };
        extra_layer3 {
            display-name = "Extra3";

            bindings =<
                &trans      &trans    &trans    &trans    &trans
                &trans      &trans    &trans    &trans    &trans
                &trans      &trans    &trans    &trans    &trans
            >;
            sensor-bindings = <&inc_dec_kp C_BRI_DEC C_BRI_INC>;

        };
        extra_layer4 {
            display-name = "Extra3";

            bindings =<
                &trans      &trans    &trans    &trans    &trans
                &trans      &trans    &trans    &trans    &trans
                &trans      &trans    &trans    &trans    &trans
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;

        };
      extra_layer5 {
            display-name = "Extra3";

            bindings =<
                &trans      &trans    &trans    &trans    &trans
                &trans      &trans    &trans    &trans    &trans
                &trans      &trans    &trans    &trans    &trans
            >;
            sensor-bindings = <&inc_dec_kp LA(TAB) LA(LS(TAB))>;

        };
    };
};
